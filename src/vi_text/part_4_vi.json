{
  "DIALOG_Quest_Tutorial_Objective006_Line005_0.9": "Hãy dựng một <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"researchstation\">Trạm Nghiên Cứu</b></color> và đưa <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"knowledge\">Tri Thức</b></color> vào thực tiễn nào!",
  "DIALOG_Quest_Tutorial_Objective007_Line001": "Xong rồi! Chúng ta đã sẵn sàng tương trợ những người sống sót khác và cùng nhau xây dựng cộng đồng nổi của mình.",
  "DIALOG_Quest_Tutorial_Objective007_Line002": "Hãy dấn bước về phía trước và tìm kiếm một người sống sót. Giải cứu họ và lắng nghe câu chuyện của họ nào!",
  "DIALOG_Quest_Tutorial_Objective007_Line003": "Cơ hội tốt nhất của chúng ta là <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"scouting\">do thám</b></color> một khu vực và hy vọng phát hiện ra ai đó từ đằng xa.",
  "DIALOG_Quest_Tutorial_Objective008_Line001": "Số <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"cannedfood\">Đồ Hộp</b></color> này sẽ giúp chúng ta cầm cự no bụng trong vài ngày, nhưng nếu muốn sinh tồn lâu dài, chúng ta sẽ cần phải tự sản xuất thức ăn.",
  "DIALOG_Quest_Tutorial_Objective008_Line002_b": "Ồ! Chúng ta đã vớt sẵn một ít <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"seaweedpatch\">Rong Biển</b></color> từ đại dương rồi, hãy dùng nó để trộn một đĩa <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"seaweedsalad\">Salad Rong Biển</b></color> nhanh gọn nào.",
  "DIALOG_Quest_Tutorial_Objective008_Line004": "Chúng ta đã có một chiếc <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"saladspinner\">Máy Vắt Salad</b></color>! Cùng làm món <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"seaweedsalad\">Salad Rong Biển</b></color> thôi nào.",
  "DIALOG_Quest_Tutorial_ReturnFromMap": "Khi thoát khỏi bản đồ, góc nhìn sẽ hướng đúng vào nơi bạn vừa xem. Nhờ vậy rất tiện quan sát quanh cụm bè và kiểm tra các địa danh.",
  "DIALOG_Quest_Tutorial_ReturnFromMap_0.9": "Khi thoát khỏi bản đồ, góc nhìn sẽ hướng đúng vào nơi bạn vừa xem. Nhờ vậy rất tiện quan sát xung quanh và kiểm tra các địa điểm.",
  "DIALOG_Quest_Tutorial_Workshops_Line001": "Để chế tạo <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"floater\">Phao Nổi</b></color>, hãy xếp hàng đợi số lượng mong muốn bằng nút <color=#0DA3DC><b>+1</b></color> và <color=#0DA3DC><b>-1</b></color>. Để liên tục sản xuất phao nổi mỗi khi có sẵn tài nguyên, hãy dùng nút <sprite=\"SurvivalGuide_Sprites\" sprite name=\"continuous\">.",
  "DIALOG_RadioSignals_Doctor_Received_01": "Thuyền trưởng ơi, vài thành viên trong đoàn đang ngã bệnh. Có thể do <sprite=\"SurvivalGuide_Sprites\" sprite name=\"pollution\"><color=#7265D6><b>ô nhiễm</b></color> gây ra. Tôi đang dò các tần số khẩn cấp và có lẽ vừa tìm thấy thứ gì đó...",
  "DIALOG_RadioSignals_Engineer_Received_01": "Thuyền trưởng, chúng ta vừa bắt được tín hiệu mới. Đó là một kênh mở, có kỹ sư nào đó đang lảm nhảm về 'cân bằng mô-men xoắn' và 'phân bổ tải trọng'. Liệu họ có thể giúp chúng ta nâng cấp <sprite=\"SurvivalGuide_Sprites\" sprite name=\"weight\"><color=#0DA3DC><b>Sức Chứa Tải Trọng</b></color> không nhỉ?",
  "DIALOG_RadioSignals_MysteriousSignal_Received_01": "Thuyền trưởng, có một đường truyền yếu ớt đang xuyên qua tiếng rè nhiễu sóng. Nó ở rất xa, có dạng chu kỳ lặp lại, giống như một tín hiệu mã hóa.",
  "DIALOG_RadioSignals_Received_01": "Thuyền trưởng, chúng ta đang bắt được nhiều tín hiệu vô tuyến!",
  "DIALOG_Radio_Addition": "<sprite=\"SurvivalGuide_Sprites\" sprite name=\"radiosignal\">",
  "DIALOG_Scouting_Cache": "Một điểm mốc dẫn tới khu định cư bỏ hoang đã được thêm vào la bàn. Có thể nơi đó vẫn còn vương lại các tài nguyên hữu ích.",
  "DIALOG_Scouting_Drifter": "Trong đêm tối, một đống lửa trại đã được phát hiện! Một người sống sót có thể đang cần chúng ta giúp đỡ. Một điểm mốc đã được thêm vào la bàn.",
  "DIALOG_Scouting_Research": "Điểm mốc dẫn tới thư viện đã được thêm vào la bàn.",
  "DIALOG_Scouting_Seagull": "Đã phát hiện một đàn chim hải âu! Điểm mốc đã được thêm vào la bàn.",
  "DIALOG_Scouting_Title": "Do thám",
  "DIALOG_SeagullJoin_Addition": "<color=#0DA3DC>+1 <sprite=\"SurvivalGuide_Sprites\" sprite name=\"seagull\"><b></b></color>",
