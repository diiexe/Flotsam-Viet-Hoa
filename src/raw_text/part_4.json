{
  "DIALOG_Quest_Tutorial_Objective006_Line005_0.9": "Let's build a <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"researchstation\">Research Station</b></color> and put our <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"knowledge\">Knowledge</b></color> to work!",
  "DIALOG_Quest_Tutorial_Objective007_Line001": "Voila! We are all set to help other survivors and build our floating community together.",
  "DIALOG_Quest_Tutorial_Objective007_Line002": "Let's venture onward and find a survivor. Rescue them and listen to their story!",
  "DIALOG_Quest_Tutorial_Objective007_Line003": "Our best chance is to <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"scouting\">scout</b></color> a region and hope we spot someone in the distance.",
  "DIALOG_Quest_Tutorial_Objective008_Line001": "This <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"cannedfood\">Canned Food</b></color> will keep us fed for a few days, but if we want to survive, we'll need to be able to make our own food.",
  "DIALOG_Quest_Tutorial_Objective008_Line002_b": "Oh! We already gathered some <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"seaweedpatch\">Seaweed</b></color> out of the ocean, let's use it whip up some quick and easy <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"seaweedsalad\">Seaweed Salad</b></color>.",
  "DIALOG_Quest_Tutorial_Objective008_Line004": "We got a <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"saladspinner\">Salad Spinner</b></color>! Let's whip up some <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"seaweedsalad\">Seaweed Salad</b></color>.",
  "DIALOG_Quest_Tutorial_ReturnFromMap": "When you return from the map, your view will match the location you were looking at. This makes it easy to look around and inspect landmarks.",
  "DIALOG_Quest_Tutorial_ReturnFromMap_0.9": "When you return from the map, your view will match the location you were looking at. This makes it easy to look around and inspect locations.",
  "DIALOG_Quest_Tutorial_Workshops_Line001": "To make <color=#0DA3DC><b><sprite=\"SurvivalGuide_Sprites\" sprite name=\"floater\">Floaters</b></color>, queue the desired amount using the <color=#0DA3DC><b>+1</b></color> and <color=#0DA3DC><b>-1</b></color> buttons. To continuously produce floaters as resources become available, use the <sprite=\"SurvivalGuide_Sprites\" sprite name=\"continuous\"> button.",
  "DIALOG_RadioSignals_Doctor_Received_01": "Captain, a few crew are falling ill. Could be caused by the <sprite=\"SurvivalGuide_Sprites\" sprite name=\"pollution\"><color=#7265D6><b>pollution</b></color>. I've been scanning emergency frequencies and might have found something...",
  "DIALOG_RadioSignals_Engineer_Received_01": "Captain, we're picking up a new signal. It's an open channel, some engineer's rambling about 'torque balance' and 'load distribution'. Think they could help us expand our <sprite=\"SurvivalGuide_Sprites\" sprite name=\"weight\"><color=#0DA3DC><b>Weight Capacity</b></color>?",
  "DIALOG_RadioSignals_MysteriousSignal_Received_01": "Captain, there’s a weak transmission cutting through the static. It’s distant, some kind of repeating pattern, like a coded signal.",
  "DIALOG_RadioSignals_Received_01": "Captain, we're picking up several radio signals!",
  "DIALOG_Radio_Addition": "<sprite=\"SurvivalGuide_Sprites\" sprite name=\"radiosignal\">",
  "DIALOG_Scouting_Cache": "A waypoint to an abandoned settlement has been added to the compass. There might be useful resources that were left behind.",
  "DIALOG_Scouting_Drifter": "During the night a camp fire was spotted! A survivor might need our help. A waypoint has been added to the compass.",
  "DIALOG_Scouting_Research": "The waypoint to a library has been added to the compass.",
  "DIALOG_Scouting_Seagull": "A flock of seagulls has been spotted! A waypoint has been added to the compass.",
  "DIALOG_Scouting_Title": "Scouting",
  "DIALOG_SeagullJoin_Addition": "<color=#0DA3DC>+1 <sprite=\"SurvivalGuide_Sprites\" sprite name=\"seagull\"><b></b></color>",
